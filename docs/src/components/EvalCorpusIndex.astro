---
const severities = [
  { id: "error", initial: "E", label: "Error" },
  { id: "warning", initial: "W", label: "Warning" },
  { id: "info", initial: "I", label: "Info" },
  { id: "none", initial: "N", label: "None" },
] as const;

const rows = [
  { id: "tiny", initial: "T", label: "Tiny", range: "1–25 changed lines", counts: { error: 3, warning: 1, info: 0, none: 0 } },
  { id: "small", initial: "S", label: "Small", range: "26–100 changed lines", counts: { error: 2, warning: 2, info: 1, none: 1 } },
  { id: "medium", initial: "M", label: "Medium", range: "101–500 changed lines", counts: { error: 4, warning: 4, info: 2, none: 0 } },
  { id: "large", initial: "L", label: "Large", range: "501+ changed lines", counts: { error: 4, warning: 3, info: 3, none: 5 } },
] as const;

const rowTotal = (row: (typeof rows)[number]) => severities.reduce((sum, severity) => sum + row.counts[severity.id], 0);
const columnTotals = Object.fromEntries(
  severities.map((severity) => [severity.id, rows.reduce((sum, row) => sum + row.counts[severity.id], 0)]),
) as Record<(typeof severities)[number]["id"], number>;
const corpusTotal = rows.reduce((sum, row) => sum + rowTotal(row), 0);
const maxCount = Math.max(...rows.flatMap((row) => severities.map((severity) => row.counts[severity.id])));
const percent = (part: number, whole: number) => (whole === 0 ? 0 : (part / whole) * 100);
const formatPercent = (value: number) => {
  const rounded = Math.round(value * 10) / 10;
  return Number.isInteger(rounded) ? String(rounded) : rounded.toFixed(1);
};
---

<eval-corpus-index data-max-count={maxCount} data-corpus-total={corpusTotal}>
  <div class="eval-corpus-index__meta" aria-label="Corpus snapshot metadata">
    <span><strong>Corpus:</strong> {corpusTotal} cases</span>
    <span><strong>Default diversified cap:</strong> 32 cases</span>
  </div>

  <div
    class="eval-corpus-index__table-wrap"
    role="region"
    aria-label="Evaluation corpus counts table"
    tabindex="0"
  >
    <table class="eval-corpus-index__table">
      <caption>Case counts by change-size bucket and highest source severity.</caption>
      <thead>
        <tr>
          <th scope="col">Change size</th>
          {severities.map((severity) => <th scope="col">{severity.label}</th>)}
          <th scope="col">Total</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row">{row.label} ({row.range.replace(" changed lines", "")})</th>
            {severities.map((severity) => <td>{row.counts[severity.id]}</td>)}
            <td><strong>{rowTotal(row)}</strong></td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr>
          <th scope="row">Total</th>
          {severities.map((severity) => <td><strong>{columnTotals[severity.id]}</strong></td>)}
          <td><strong>{corpusTotal}</strong></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="eval-corpus-index__chart" aria-label="Interactive heatmap of evaluation corpus cases">
    <div class="eval-corpus-index__toolbar">
      <div class="eval-corpus-index__modes" role="group" aria-label="Heatmap shading">
        <button type="button" data-mode="count" aria-pressed="true">Count</button>
        <button type="button" data-mode="share" aria-pressed="false">Within-size %</button>
      </div>
      <div class="eval-corpus-index__scale" aria-hidden="true">
        <span>0</span>
        <span class="eval-corpus-index__scale-ramp"></span>
        <span data-scale-maximum>{maxCount}</span>
      </div>
    </div>

    <div class="eval-corpus-index__heatmap" role="group" aria-label="Rows are change sizes; columns are highest source severities">
      <span aria-hidden="true"></span>
      {severities.map((severity) => (
        <abbr
          class="eval-corpus-index__axis-label eval-corpus-index__axis-label--column"
          data-axis-kind="severity"
          data-axis-value={severity.id}
          data-axis-label={severity.label}
          data-axis-total={columnTotals[severity.id]}
          title={severity.label}
          aria-label={severity.label}
        >
          {severity.initial}
        </abbr>
      ))}
      <span class="eval-corpus-index__total-label eval-corpus-index__total-label--header">Total</span>

      {rows.map((row) => {
        const total = rowTotal(row);
        const fullRowLabel = `${row.label}: ${row.range}`;
        return (
          <>
            <abbr
              class="eval-corpus-index__axis-label eval-corpus-index__axis-label--row"
              data-axis-kind="row"
              data-axis-value={row.id}
              data-axis-label={fullRowLabel}
              data-axis-total={total}
              title={fullRowLabel}
              aria-label={fullRowLabel}
            >
              {row.initial}
            </abbr>
            {severities.map((severity) => {
              const count = row.counts[severity.id];
              const rowShare = percent(count, total);
              const corpusShare = percent(count, corpusTotal);
              const level = count === 0 ? 0 : Math.ceil((count / maxCount) * 5);
              const description = `${row.label} (${row.range}) × ${severity.label}: ${count} ${count === 1 ? "case" : "cases"}; ${count} of ${total} in this size bucket (${formatPercent(rowShare)}%); ${count} of ${corpusTotal} in the corpus (${formatPercent(corpusShare)}%).`;
              return (
                <button
                  type="button"
                  class="eval-corpus-index__cell"
                  data-row={row.id}
                  data-row-label={`${row.label} (${row.range})`}
                  data-severity={severity.id}
                  data-severity-label={severity.label}
                  data-count={count}
                  data-row-total={total}
                  data-level={level}
                  aria-label={description}
                  aria-pressed="false"
                >
                  <span class="eval-corpus-index__primary">{count}</span>
                  <span class="eval-corpus-index__secondary">{formatPercent(rowShare)}%</span>
                </button>
              );
            })}
            <span class="eval-corpus-index__row-total" aria-label={`${fullRowLabel}: ${total} cases`}>{total}</span>
          </>
        );
      })}

      <span class="eval-corpus-index__total-label eval-corpus-index__total-label--footer">Total</span>
      {severities.map((severity) => (
        <span class="eval-corpus-index__column-total" aria-label={`${severity.label}: ${columnTotals[severity.id]} cases`}>
          {columnTotals[severity.id]}
        </span>
      ))}
      <span class="eval-corpus-index__grand-total" aria-label={`${corpusTotal} cases total`}>{corpusTotal}</span>
    </div>

    <p class="eval-corpus-index__detail" data-detail aria-live="polite">
      Hover, focus, or select a cell for its full labels and proportions.
    </p>
  </div>
</eval-corpus-index>

<script>
  type HeatmapMode = "count" | "share";

  class EvalCorpusIndex extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === "true") return;
      this.dataset.ready = "true";

      const cells = Array.from(this.querySelectorAll<HTMLButtonElement>(".eval-corpus-index__cell"));
      const axes = Array.from(this.querySelectorAll<HTMLElement>(".eval-corpus-index__axis-label"));
      const modeButtons = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-mode]"));
      const detail = this.querySelector<HTMLElement>("[data-detail]");
      const scaleMaximum = this.querySelector<HTMLElement>("[data-scale-maximum]");
      const corpusTotal = Number(this.dataset.corpusTotal);
      const maxCount = Number(this.dataset.maxCount);
      let mode: HeatmapMode = "count";
      let pinnedCell: HTMLButtonElement | null = null;

      const formatPercent = (value: number) => {
        const rounded = Math.round(value * 10) / 10;
        return Number.isInteger(rounded) ? String(rounded) : rounded.toFixed(1);
      };

      const cellDescription = (cell: HTMLButtonElement) => {
        const count = Number(cell.dataset.count);
        const rowTotal = Number(cell.dataset.rowTotal);
        const rowShare = rowTotal === 0 ? 0 : (count / rowTotal) * 100;
        const corpusShare = corpusTotal === 0 ? 0 : (count / corpusTotal) * 100;
        const noun = count === 1 ? "case" : "cases";
        return `${cell.dataset.rowLabel} × ${cell.dataset.severityLabel}: ${count} ${noun}; ${count} of ${rowTotal} in this size bucket (${formatPercent(rowShare)}%); ${count} of ${corpusTotal} in the corpus (${formatPercent(corpusShare)}%).`;
      };

      const clearHighlight = () => {
        for (const cell of cells) {
          cell.classList.remove("is-active", "is-related", "is-muted");
        }
        if (detail) detail.textContent = "Hover, focus, or select a cell for its full labels and proportions.";
      };

      const highlightCell = (cell: HTMLButtonElement) => {
        for (const candidate of cells) {
          const related = candidate.dataset.row === cell.dataset.row || candidate.dataset.severity === cell.dataset.severity;
          candidate.classList.toggle("is-active", candidate === cell);
          candidate.classList.toggle("is-related", related && candidate !== cell);
          candidate.classList.toggle("is-muted", !related);
        }
        if (detail) detail.textContent = cellDescription(cell);
      };

      const highlightAxis = (axis: HTMLElement) => {
        const kind = axis.dataset.axisKind;
        const value = axis.dataset.axisValue;
        for (const cell of cells) {
          const related = kind === "row" ? cell.dataset.row === value : cell.dataset.severity === value;
          cell.classList.toggle("is-related", related);
          cell.classList.toggle("is-muted", !related);
          cell.classList.remove("is-active");
        }
        if (detail) {
          const count = Number(axis.dataset.axisTotal);
          detail.textContent = `${axis.dataset.axisLabel}: ${count} ${count === 1 ? "case" : "cases"}.`;
        }
      };

      const renderMode = (nextMode: HeatmapMode) => {
        mode = nextMode;
        for (const button of modeButtons) {
          button.setAttribute("aria-pressed", String(button.dataset.mode === mode));
        }
        if (scaleMaximum) scaleMaximum.textContent = mode === "count" ? String(maxCount) : "100%";

        for (const cell of cells) {
          const count = Number(cell.dataset.count);
          const rowTotal = Number(cell.dataset.rowTotal);
          const rowShare = rowTotal === 0 ? 0 : (count / rowTotal) * 100;
          const primary = cell.querySelector(".eval-corpus-index__primary");
          const secondary = cell.querySelector(".eval-corpus-index__secondary");
          if (primary) primary.textContent = mode === "count" ? String(count) : `${formatPercent(rowShare)}%`;
          if (secondary) secondary.textContent = mode === "count" ? `${formatPercent(rowShare)}%` : `${count} ${count === 1 ? "case" : "cases"}`;
          const ratio = mode === "count" ? count / maxCount : rowShare / 100;
          cell.dataset.level = count === 0 ? "0" : String(Math.max(1, Math.ceil(ratio * 5)));
        }

        if (pinnedCell) highlightCell(pinnedCell);
      };

      for (const cell of cells) {
        cell.addEventListener("pointerenter", () => {
          if (!pinnedCell) highlightCell(cell);
        });
        cell.addEventListener("pointerleave", () => {
          if (!pinnedCell) clearHighlight();
        });
        cell.addEventListener("focus", () => highlightCell(cell));
        cell.addEventListener("blur", () => {
          if (pinnedCell) {
            highlightCell(pinnedCell);
          } else {
            clearHighlight();
          }
        });
        cell.addEventListener("click", () => {
          if (pinnedCell === cell) {
            pinnedCell = null;
            cell.setAttribute("aria-pressed", "false");
            clearHighlight();
            return;
          }
          if (pinnedCell) pinnedCell.setAttribute("aria-pressed", "false");
          pinnedCell = cell;
          cell.setAttribute("aria-pressed", "true");
          highlightCell(cell);
        });
      }

      for (const axis of axes) {
        axis.addEventListener("pointerenter", () => {
          if (!pinnedCell) highlightAxis(axis);
        });
        axis.addEventListener("pointerleave", () => {
          if (!pinnedCell) clearHighlight();
        });
      }

      for (const button of modeButtons) {
        button.addEventListener("click", () => renderMode(button.dataset.mode === "share" ? "share" : "count"));
      }
    }
  }

  if (!customElements.get("eval-corpus-index")) {
    customElements.define("eval-corpus-index", EvalCorpusIndex);
  }
</script>

<style>
  eval-corpus-index {
    display: block;
    margin-block: 1rem 1.5rem;
  }

  .eval-corpus-index__meta,
  .eval-corpus-index__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    flex-wrap: wrap;
  }

  .eval-corpus-index__meta {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .eval-corpus-index__table-wrap {
    overflow-x: auto;
    margin-block: 0.75rem 1.5rem;
  }

  .eval-corpus-index__table-wrap:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 0.2rem;
  }

  .eval-corpus-index__table {
    width: 100%;
    min-width: 32rem;
    margin: 0;
  }

  .eval-corpus-index__table caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .eval-corpus-index__table th:not(:first-child),
  .eval-corpus-index__table td {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .eval-corpus-index__chart {
    margin-top: 1rem;
  }

  .eval-corpus-index__modes {
    display: inline-flex;
    gap: 0.25rem;
  }

  .eval-corpus-index__modes button {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.35rem 0.6rem;
  }

  .eval-corpus-index__modes button[aria-pressed="true"] {
    border-color: var(--sl-color-text);
    background: var(--sl-color-text);
    color: var(--sl-color-bg);
  }

  .eval-corpus-index__scale {
    display: grid;
    grid-template-columns: auto minmax(5rem, 9rem) auto;
    align-items: center;
    gap: 0.4rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
  }

  .eval-corpus-index__scale-ramp {
    height: 0.65rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--sl-color-gray-6), color-mix(in srgb, var(--sl-color-accent) 46%, var(--sl-color-bg)));
  }

  .eval-corpus-index__heatmap {
    display: grid;
    grid-template-columns: minmax(2.5rem, 0.6fr) repeat(4, minmax(3.25rem, 1fr)) minmax(3rem, 0.65fr);
    align-items: stretch;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .eval-corpus-index__axis-label,
  .eval-corpus-index__total-label,
  .eval-corpus-index__row-total,
  .eval-corpus-index__column-total,
  .eval-corpus-index__grand-total {
    display: grid;
    place-items: center;
    min-height: 2.25rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-variant-numeric: tabular-nums;
  }

  .eval-corpus-index__axis-label {
    border: 0;
    cursor: help;
    font-weight: 600;
    text-decoration: none;
  }

  .eval-corpus-index__row-total,
  .eval-corpus-index__column-total,
  .eval-corpus-index__grand-total {
    font-weight: 600;
  }

  .eval-corpus-index__cell {
    display: grid;
    place-items: center;
    align-content: center;
    min-height: 3.75rem;
    padding: 0.35rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    cursor: pointer;
    font: inherit;
    transition: border-color 120ms ease, opacity 120ms ease, transform 120ms ease;
  }

  .eval-corpus-index__cell[data-level="1"] { background: color-mix(in srgb, var(--sl-color-accent) 12%, var(--sl-color-bg)); }
  .eval-corpus-index__cell[data-level="2"] { background: color-mix(in srgb, var(--sl-color-accent) 20%, var(--sl-color-bg)); }
  .eval-corpus-index__cell[data-level="3"] { background: color-mix(in srgb, var(--sl-color-accent) 28%, var(--sl-color-bg)); }
  .eval-corpus-index__cell[data-level="4"] { background: color-mix(in srgb, var(--sl-color-accent) 37%, var(--sl-color-bg)); }
  .eval-corpus-index__cell[data-level="5"] { background: color-mix(in srgb, var(--sl-color-accent) 46%, var(--sl-color-bg)); }

  .eval-corpus-index__cell[data-level="0"] {
    border-style: dashed;
  }

  .eval-corpus-index__cell:hover,
  .eval-corpus-index__cell:focus-visible,
  .eval-corpus-index__cell.is-active {
    border-color: var(--sl-color-accent);
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .eval-corpus-index__cell.is-related {
    border-color: var(--sl-color-accent-high);
  }

  .eval-corpus-index__cell.is-muted {
    border-color: var(--sl-color-gray-6);
    background: var(--sl-color-gray-6);
  }

  .eval-corpus-index__primary {
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .eval-corpus-index__secondary {
    margin-top: 0.15rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .eval-corpus-index__detail {
    min-height: 2.5rem;
    margin-block: 0.75rem 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  @media (max-width: 30rem) {
    .eval-corpus-index__heatmap {
      grid-template-columns: 1.75rem repeat(4, minmax(2.5rem, 1fr));
      gap: 0.3rem;
    }

    .eval-corpus-index__total-label--header,
    .eval-corpus-index__row-total,
    .eval-corpus-index__grand-total {
      display: none;
    }

    .eval-corpus-index__cell {
      min-height: 3.25rem;
      padding-inline: 0.15rem;
    }

    .eval-corpus-index__secondary {
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eval-corpus-index__cell {
      transition: none;
    }
  }
</style>
